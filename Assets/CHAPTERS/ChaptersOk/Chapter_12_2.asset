  nodes:
  - speaker: {fileID: 0}
    text: "Je vais te laisser tranquille, du coup\u2026"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 0
