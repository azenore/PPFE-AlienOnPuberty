    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    text: "Oh ? Tu abandonnes d\xE9j\xE0 ta tentative d'approche ?"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 1
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "C'\xE9tait pas une tentative d'approche !"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 1
    overrideProtagonistEmotion: 1
    protagonistEmotion: 3
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "(Mes oreilles recommencent brusquement \xE0 me d\xE9manger.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 1
    overrideProtagonistEmotion: 1
    protagonistEmotion: 4
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: (Ok. Il faut vraiment que je parte.)
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 1
    overrideProtagonistEmotion: 1
    protagonistEmotion: 2
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "Excuse-moi une seconde\u2014"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 6686945e7a2fd09409967e9a736712f5, type: 2}
    characterOnScreenEmotion: 4
    overrideProtagonistEmotion: 1
    protagonistEmotion: 4
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: (Je tourne rapidement les talons et traverse la foule.)
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 1
    protagonistEmotion: 4
    isMonologue: 1
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "(La musique me para\xEEt soudain beaucoup trop forte.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 1
    protagonistEmotion: 2
    isMonologue: 1
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: (Respire. Calme-toi.)
