%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2e0357ddfcb993e42a8fbc0aff04b250, type: 3}
  m_Name: Chapter_6
  m_EditorClassIdentifier: 
  chapterTitle: "La soir\xE9e"
  background: {fileID: 21300000, guid: 0ec333ae0b4005e4287738099a075175, type: 3}
  backgroundMusic: {fileID: 0}
  nodes:
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "On a une soir\xE9e !"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "(Linh a le sourire jusqu'aux oreilles. Il faut dire que la soir\xE9e d'int\xE9gration
      de l'Acad\xE9mie est r\xE9put\xE9e.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "Je sais pas si c'est une bonne id\xE9e\u2026"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "Comment la soir\xE9e de notre vie pourrait \xEAtre une mauvaise id\xE9e
      ?"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 3
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: Le monde.
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "Et mon \xAB \xE9tat \xBB."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "Pour l'instant, ton \xE9tat, c'est rien du tout. Tu vas pas t'emp\xEAcher
      de vivre pour \xE7a, on a dit."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 3
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: On voit que c'est pas toi qui risques de te faire pousser des antennes
      ou des trucs du genre.
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: Tu pourras capter la 5G avec ?
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 1
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "Je suis s\xE9rieuse, Linh."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "Oui, je sais. Mais il est hors de question que je te laisse louper \xE7a."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "C'est juste une soir\xE9e."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "C'est le moment de rencontrer du monde et de s'int\xE9grer. On suit pas
      le m\xEAme cursus, alors ce serait bien d'avoir quelques connaissances avant
      la rentr\xE9e. Tu crois pas ?"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "Si, bien s\xFBr\u2026"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "(Quand Linh est d\xE9termin\xE9e, c'est difficile de la faire changer
      d'avis\u2026 mais j'avoue que j'ai envie d'aller \xE0 cette soir\xE9e.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 1
    backgroundOverride: {fileID: 0}
  transition:
    nextChapter: {fileID: 11400000, guid: 8d0cbd27f683e024bb6eef5dcbe45671, type: 2}
  affinityRequirements: []
