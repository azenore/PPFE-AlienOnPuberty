  backgroundMusic: {fileID: 8300000, guid: 07d774bd39f45164e894554acc28c090, type: 3}
  nodes:
  - speaker: {fileID: 0}
    text: "(Il n'y avait aucun doute, nous \xE9tions arriv\xE9es \xE0 bon port. Des
      centaines de jeunes un peu partout, des tentes dress\xE9es \xE7\xE0 et l\xE0,
      et une superbe maison nous faisaient face.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 1
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    text: "Ah ouais, y'a du monde quand m\xEAme."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 11400000, guid: 69e150ffe7048754eb5d7c077c74dc8d, type: 2}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "On peut plus faire marche arri\xE8re maintenant."
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 1
    protagonistEmotion: 2
    isMonologue: 0
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: "(On s'est avanc\xE9es toutes les deux vers le portail. Devant nous, un
      homme assurait la s\xE9curit\xE9. Il a regard\xE9 nos billets sans y pr\xEAter
      trop attention et nous a laiss\xE9 entrer.)"
    voiceClip: {fileID: 0}
    choices: []
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 1
    backgroundOverride: {fileID: 0}
  - speaker: {fileID: 0}
    text: (Je pouvais soit commencer par faire un tour du jardin, soit rentrer directement
      dans la maison.)
    voiceClip: {fileID: 0}
    choices:
    - label: Entrer dans la maison
      affinityTarget: {fileID: 0}
      affinityDelta: 0
      nextChapter: {fileID: 11400000, guid: 13251ffcf2248d843b6009654c6401a6, type: 2}
    - label: Visiter le jardin
      affinityTarget: {fileID: 0}
      affinityDelta: 0
      nextChapter: {fileID: 11400000, guid: f654f491adbf7544d87c31b23a612c2d, type: 2}
    characterOnScreen: {fileID: 0}
    characterOnScreenEmotion: 0
    overrideProtagonistEmotion: 0
    protagonistEmotion: 0
    isMonologue: 1
    backgroundOverride: {fileID: 0}
